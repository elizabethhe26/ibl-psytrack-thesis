# Python
__pycache__/
*.pyc
*.pyo
*.egg-info/

# Data files (large, auto-downloaded)
data/raw/*.csv

# Intermediate pipeline artifacts (regenerated by run_all.py)
intermediate/*.pkl
intermediate/*.csv

# Output (regenerated by run_all.py)
output/figures/*.pdf
output/figures/*.png
output/tables/*.csv
output/latex/*.tex
output/latex/*.txt

# IDE
.vscode/
.idea/
*.swp
